# Copy to .env and fill in. Never commit .env or real keys.
# Server port (default 4000)
PORT=4000

# Optional TMDB metadata enrichment (Phase 1). Leave empty until the user provides a real key.
TMDB_API_KEY=

# FFmpeg/FFprobe executables (Phase 3). Defaults resolve from PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional path to a local multi-audio test fixture (generated by scripts/make-test-fixture.mjs).
# When set, /api/stream resolves playback from this fixture instead of a provider stream.
STREAMIX_FIXTURE=
